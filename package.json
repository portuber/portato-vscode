{
  "name": "portato-vscode",
  "displayName": "Portato",
  "description": "%extension.description%",
  "version": "0.2.0",
  "publisher": "portuber",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/portuber/portato-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/portuber/portato-vscode/issues"
  },
  "homepage": "https://github.com/portuber/portato-vscode#readme",
  "keywords": [
    "ssh",
    "port-forwarding",
    "tunnel",
    "tunnels",
    "socks",
    "proxy"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "portato",
          "title": "Portato",
          "icon": "media/portato.svg"
        }
      ]
    },
    "views": {
      "portato": [
        {
          "id": "portatoTunnels",
          "name": "%view.tunnels%"
        }
      ]
    },
    "commands": [
      {
        "command": "portato.refresh",
        "category": "Portato",
        "title": "%cmd.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "portato.startDaemon",
        "category": "Portato",
        "title": "%cmd.startDaemon.title%",
        "icon": "$(play)"
      },
      {
        "command": "portato.stopDaemon",
        "category": "Portato",
        "title": "%cmd.stopDaemon.title%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "portato.enable",
        "category": "Portato",
        "title": "%cmd.enable.title%",
        "icon": "$(debug-start)"
      },
      {
        "command": "portato.disable",
        "category": "Portato",
        "title": "%cmd.disable.title%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "portato.restart",
        "category": "Portato",
        "title": "%cmd.restart.title%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "portato.answerPrompt",
        "category": "Portato",
        "title": "%cmd.answerPrompt.title%",
        "icon": "$(key)"
      },
      {
        "command": "portato.showLogs",
        "category": "Portato",
        "title": "%cmd.showLogs.title%",
        "icon": "$(output)"
      },
      {
        "command": "portato.showTuberLogs",
        "category": "Portato",
        "title": "%cmd.showTuberLogs.title%",
        "icon": "$(output)"
      },
      {
        "command": "portato.setLogLevel",
        "category": "Portato",
        "title": "%cmd.setLogLevel.title%",
        "icon": "$(list-filter)"
      },
      {
        "command": "portato.storeIdentity",
        "category": "Portato",
        "title": "%cmd.storeIdentity.title%",
        "icon": "$(key)"
      },
      {
        "command": "portato.forgetIdentity",
        "category": "Portato",
        "title": "%cmd.forgetIdentity.title%",
        "icon": "$(key)"
      },
      {
        "command": "portato.filterTunnels",
        "category": "Portato",
        "title": "%cmd.filterTunnels.title%",
        "icon": "$(filter)"
      },
      {
        "command": "portato.clearFilter",
        "category": "Portato",
        "title": "%cmd.clearFilter.title%",
        "icon": "$(close)"
      },
      {
        "command": "portato.addTunnel",
        "category": "Portato",
        "title": "%cmd.addTunnel.title%",
        "icon": "$(add)"
      },
      {
        "command": "portato.editTunnel",
        "category": "Portato",
        "title": "%cmd.editTunnel.title%",
        "icon": "$(edit)"
      },
      {
        "command": "portato.deleteTunnel",
        "category": "Portato",
        "title": "%cmd.deleteTunnel.title%",
        "icon": "$(trash)"
      },
      {
        "command": "portato.reloadConfig",
        "category": "Portato",
        "title": "%cmd.reloadConfig.title%",
        "icon": "$(sync)"
      },
      {
        "command": "portato.statusPicker",
        "category": "Portato",
        "title": "%cmd.statusPicker.title%",
        "icon": "$(list-selection)"
      },
      {
        "command": "portato.openLanding",
        "category": "Portato",
        "title": "%cmd.openLanding.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "portato.copyAddress",
        "category": "Portato",
        "title": "%cmd.copyAddress.title%",
        "icon": "$(copy)"
      },
      {
        "command": "portato.openInBrowser",
        "category": "Portato",
        "title": "%cmd.openInBrowser.title%",
        "icon": "$(globe)"
      },
      {
        "command": "portato.copySocksUrl",
        "category": "Portato",
        "title": "%cmd.copySocksUrl.title%",
        "icon": "$(plug)"
      },
      {
        "command": "portato.filterTag",
        "category": "Portato",
        "title": "%cmd.filterTag.title%",
        "icon": "$(filter)"
      },
      {
        "command": "portato.addTunnelWithTag",
        "category": "Portato",
        "title": "%cmd.addTunnelWithTag.title%",
        "icon": "$(add)"
      }
    ],
    "viewsWelcome": [
      {
        "view": "portatoTunnels",
        "contents": "%welcome.noBinary%",
        "when": "portato:viewState == noBinary"
      },
      {
        "view": "portatoTunnels",
        "contents": "%welcome.stopped%",
        "when": "portato:viewState == stopped"
      },
      {
        "view": "portatoTunnels",
        "contents": "%welcome.rejected%",
        "when": "portato:viewState == rejected"
      },
      {
        "view": "portatoTunnels",
        "contents": "%welcome.empty%",
        "when": "portato:viewState == empty"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "portato.startDaemon",
          "when": "view == portatoTunnels && !portato:daemonRunning",
          "group": "navigation@2"
        },
        {
          "command": "portato.stopDaemon",
          "when": "view == portatoTunnels && portato:daemonRunning",
          "group": "navigation@2"
        },
        {
          "command": "portato.refresh",
          "when": "view == portatoTunnels",
          "group": "navigation@0"
        },
        {
          "command": "portato.showLogs",
          "when": "view == portatoTunnels",
          "group": "navigation@1"
        },
        {
          "command": "portato.setLogLevel",
          "when": "view == portatoTunnels",
          "group": "navigation@3"
        },
        {
          "command": "portato.filterTunnels",
          "when": "view == portatoTunnels",
          "group": "navigation@4"
        },
        {
          "command": "portato.clearFilter",
          "when": "view == portatoTunnels && portato:filterActive",
          "group": "navigation@4"
        },
        {
          "command": "portato.addTunnel",
          "when": "view == portatoTunnels && portato:daemonRunning",
          "group": "navigation@5"
        },
        {
          "command": "portato.reloadConfig",
          "when": "view == portatoTunnels && portato:daemonRunning",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "portato.enable",
          "when": "view == portatoTunnels && viewItem =~ /^off:/",
          "group": "inline"
        },
        {
          "command": "portato.disable",
          "when": "view == portatoTunnels && viewItem =~ /^(connecting|connected|reconnecting|error|prompting):/",
          "group": "inline"
        },
        {
          "command": "portato.restart",
          "when": "view == portatoTunnels && viewItem =~ /^(connecting|connected|reconnecting|error|prompting):/",
          "group": "inline"
        },
        {
          "command": "portato.answerPrompt",
          "when": "view == portatoTunnels && viewItem =~ /^prompting:/",
          "group": "inline@1"
        },
        {
          "command": "portato.copyAddress",
          "when": "view == portatoTunnels && viewItem =~ /^(off|connecting|connected|reconnecting|error|prompting):/",
          "group": "1_copy"
        },
        {
          "command": "portato.openInBrowser",
          "when": "view == portatoTunnels && viewItem =~ /:local$/",
          "group": "1_copy"
        },
        {
          "command": "portato.copySocksUrl",
          "when": "view == portatoTunnels && viewItem =~ /:dynamic$/",
          "group": "1_copy"
        },
        {
          "command": "portato.showTuberLogs",
          "when": "view == portatoTunnels && viewItem =~ /^(off|connecting|connected|reconnecting|error|prompting):/",
          "group": "2_tunnels"
        },
        {
          "command": "portato.storeIdentity",
          "when": "view == portatoTunnels && viewItem =~ /^(off|connecting|connected|reconnecting|error|prompting):/",
          "group": "3_ident"
        },
        {
          "command": "portato.forgetIdentity",
          "when": "view == portatoTunnels && viewItem =~ /^(off|connecting|connected|reconnecting|error|prompting):/",
          "group": "3_ident"
        },
        {
          "command": "portato.editTunnel",
          "when": "view == portatoTunnels && viewItem =~ /^(off|connecting|connected|reconnecting|error|prompting):/",
          "group": "4_edit"
        },
        {
          "command": "portato.deleteTunnel",
          "when": "view == portatoTunnels && viewItem =~ /^(off|connecting|connected|reconnecting|error|prompting):/",
          "group": "4_edit"
        },
        {
          "command": "portato.filterTag",
          "when": "view == portatoTunnels && viewItem == tagGroup",
          "group": "1_tag"
        },
        {
          "command": "portato.addTunnelWithTag",
          "when": "view == portatoTunnels && viewItem == tagGroup",
          "group": "1_tag"
        }
      ],
      "commandPalette": [
        {
          "command": "portato.enable",
          "when": "false"
        },
        {
          "command": "portato.disable",
          "when": "false"
        },
        {
          "command": "portato.restart",
          "when": "false"
        },
        {
          "command": "portato.answerPrompt",
          "when": "false"
        },
        {
          "command": "portato.showTuberLogs",
          "when": "false"
        },
        {
          "command": "portato.storeIdentity",
          "when": "false"
        },
        {
          "command": "portato.forgetIdentity",
          "when": "false"
        },
        {
          "command": "portato.clearFilter",
          "when": "false"
        },
        {
          "command": "portato.editTunnel",
          "when": "false"
        },
        {
          "command": "portato.deleteTunnel",
          "when": "false"
        },
        {
          "command": "portato.copyAddress",
          "when": "false"
        },
        {
          "command": "portato.openInBrowser",
          "when": "false"
        },
        {
          "command": "portato.copySocksUrl",
          "when": "false"
        },
        {
          "command": "portato.filterTag",
          "when": "false"
        },
        {
          "command": "portato.addTunnelWithTag",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Portato",
      "properties": {
        "portato.binaryPath": {
          "type": "string",
          "default": "portato",
          "scope": "machine",
          "markdownDescription": "%cfg.binaryPath.desc%"
        },
        "portato.socketPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%cfg.socketPath.desc%"
        },
        "portato.groupByTag": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cfg.groupByTag.desc%"
        },
        "portato.minLogLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ],
          "default": "info",
          "markdownDescription": "%cfg.minLogLevel.desc%"
        },
        "portato.autoStartDaemon": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "%cfg.autoStartDaemon.desc%"
        },
        "portato.showNotifications": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.showNotifications.desc%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run compile && node --test out/test/*.test.js",
    "test:integration": "npm run compile && node --test out/test/*.itest.js",
    "test:all": "npm run compile && node --test out/test/*.test.js out/test/*.itest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  }
}
