# Explicit list of everything non-runtime. vsce merges this file with its
# built-in defaults rather than replacing them; entries that overlap the
# defaults are kept for clarity. The runtime payload is out/extension.js +
# package.json + package.nls.json + README.md + LICENSE + media/
# (+ CHANGELOG.md when it exists), minus the demo animation below.
.vscodeignore
.vscode/**
.git
.github
.nvmrc
.opencode
AGENTS.md
.gitignore
node_modules/**
src/**
out/test/**
out/**/*.map
esbuild.js
tsconfig.json
Makefile
checksums.txt
release-notes.md
package-lock.json
*.vsix
# README demo animation: GitHub serves it from the repo; shipping 1.3 MB in
# the vsix only bloats the Marketplace download.
media/demo.gif
